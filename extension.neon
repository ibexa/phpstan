parameters:
	stubFiles:
		- stubs/Money/Currencies.stub
		- stubs/Money/Currency.stub
		- stubs/Money/Money.stub
		- stubs/Money/MoneyFormatter.stub
		- stubs/Money/MoneyParser.stub
rules:
    - Ibexa\PHPStan\Rules\NoConfigResolverParametersInConstructorRule
    - Ibexa\PHPStan\Rules\RequireClosureReturnTypeRule
    - PHPStan\Rules\StrictCalls\DynamicCallOnStaticMethodsRule
    - PHPStan\Rules\StrictCalls\DynamicCallOnStaticMethodsCallableRule
